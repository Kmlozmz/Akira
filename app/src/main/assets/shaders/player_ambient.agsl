uniform float2 viewport;
uniform float4 baseColor;
uniform float4 palette[5];
uniform float4 fields[5];

half4 main(float2 position) {
    float2 uv=position/viewport;
    float3 color=baseColor.rgb*.04;
    float total=.04;
    for(int i=0;i<5;i++) {
        float2 delta=uv-fields[i].xy;
        float weight=exp(-dot(delta,delta)/fields[i].z);
        color+=palette[i].rgb*weight;
        total+=weight;
    }
    color/=total;
    color*=1.-mix(.03,.12,clamp(uv.y,0.,1.));
    return half4(color,1.);
}
